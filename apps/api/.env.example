PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/sendam?sslmode=require
# Comma-separated origins allowed to call the REST API (admin + landing apps).
# Required in production; when empty in dev, all origins are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Admin dashboard auth. ADMIN_PASSWORD is the login password; JWT_SECRET signs
# session tokens (use a long random value: openssl rand -hex 32). Both are
# required — the API will not start without them.
ADMIN_PASSWORD=
JWT_SECRET=
# Optional: admin session lifetime in hours (default 12).
ADMIN_SESSION_TTL_HOURS=12
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token
# Meta App Secret — verifies the X-Hub-Signature-256 header on webhook POSTs.
# Required in production; without it, forged webhook events are rejected.
WHATSAPP_APP_SECRET=

# --- Secure PIN entry (WhatsApp Flows) ---
# Without these, payment PINs fall back to being typed into the chat thread,
# where they are stored permanently in both parties' message history.
# Setup: docs/whatsapp-pin-flow.md
WHATSAPP_PIN_FLOW_ID=
# RSA-2048 private key (PEM). Generate with: node scripts/generate-flow-keys.js
# Newlines may be escaped as \n for hosting dashboards that reject multi-line values.
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# Set to false to refuse in-chat PINs even when no Flow is configured. Sends
# then cannot be confirmed at all — the safe failure.
ALLOW_IN_CHAT_PIN=true
# Per-user transfer guardrails (USDC). Defaults: 1000 / 5000 / 50.
MAX_SEND_AMOUNT=1000
DAILY_SEND_LIMIT=5000
MAX_SENDS_PER_DAY=50
# Request rate limits (PostgreSQL-backed, shared across instances).
# REST API: max requests per IP per window. WhatsApp bot: max messages per
# sender per window.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
BOT_RATE_WINDOW_SEC=60
BOT_RATE_MAX=20
REDIS_URL=
UPSTASH_REDIS_URL=

# The REST wallet API (/api/wallet/*) is unauthenticated — the phone number in
# the request body is the only identity. It's disabled in production unless you
# set this to "true". Outside production it defaults to enabled for local tests.
ENABLE_WALLET_REST_API=false

# sendam-ai: deployed intent-decoding microservice (POST /decode) used to
# parse "send" requests from free-form chat text (English/Pidgin/Yoruba/
# Igbo/Hausa, plus "5k"/"1.5m" shorthand). Requests are HMAC-SHA256 signed
# over the raw JSON body — SENDAM_AI_SIGNING_SECRET must match the
# SERVICE_SIGNING_SECRET configured on the sendam-ai deployment itself.
# Without a valid secret here, SEND intent detection silently falls back to
# the generic help message (decode() throws, caught and logged).
SENDAM_AI_BASE_URL=https://intent-decoder.onrender.com
SENDAM_AI_SIGNING_SECRET=
# Per-request timeout. sendam-ai runs on Render's free tier, which spins
# down after ~15 min idle; a cold start can take 10s+. Default (30000)
# covers that, and sendamAi.client.js retries once on a timeout so a cold
# start on the first attempt doesn't fail the request outright.
SENDAM_AI_TIMEOUT_MS=30000

# Passkey (WebAuthn) enrollment during onboarding. rpID is the exact domain
# (no scheme/port) and origin is the exact scheme+domain+port apps/landing is
# served from — a mismatch hard-fails every ceremony client-side. Override
# both for local dev (e.g. WEBAUTHN_RP_ID=localhost).
WEBAUTHN_RP_ID=send-am-web.vercel.app
WEBAUTHN_ORIGIN=https://send-am-web.vercel.app

# Lisk is the settlement layer for every route the Payment Orchestrator picks.
LISK_CHAIN_ID=lisk
LISK_RPC_URL=
LISK_ESCROW_CONTRACT_ADDRESS=
LISK_USDC_CONTRACT_ADDRESS=
LISK_EXPLORER_BASE_URL=
# A funded platform wallet that pays sendam-paymaster-planned gas top-ups into
# user wallets before an on-chain send (see gasTopup.js).
LISK_GAS_WALLET_ADDRESS=

# sendam-custody: private HTTP microservice that generates and holds every
# wallet signing key, and is the only process that signs a transfer. Requests
# are HMAC-SHA256 signed over the raw JSON body — CUSTODY_SIGNING_SECRET must
# match SERVICE_SIGNING_SECRET on the sendam-custody deployment.
#
# REQUIRED. Without it no wallet can be created and no transfer can be signed.
# There is deliberately no local fallback: a fallback would mean a signing key
# in this process, which is exactly what this boundary exists to prevent.
CUSTODY_BASE_URL=
CUSTODY_SIGNING_SECRET=
CUSTODY_TIMEOUT_MS=20000

# sendam-paymaster: private HTTP microservice that plans (never submits) gas
# top-ups for custodied Lisk wallets. Requests are HMAC-SHA256 signed
# over the raw JSON body, same contract as sendam-ai — PAYMASTER_SIGNING_SECRET
# must match SERVICE_SIGNING_SECRET on the sendam-paymaster deployment.
PAYMASTER_BASE_URL=
PAYMASTER_SIGNING_SECRET=
PAYMASTER_TIMEOUT_MS=15000

# sendam-settlement: private HTTP microservice — internal double-entry
# ledger, fee quoting, and treasury bookkeeping (not on-chain balances).
# Requests are HMAC-SHA256 signed over the raw JSON body, same contract as
# sendam-ai — SETTLEMENT_SIGNING_SECRET must match SERVICE_SIGNING_SECRET on
# the sendam-settlement deployment.
SETTLEMENT_BASE_URL=
SETTLEMENT_SIGNING_SECRET=
SETTLEMENT_TIMEOUT_MS=15000
# Ledger account fee revenue from executed sends is recorded against, purely
# for internal reconciliation.
SETTLEMENT_TREASURY_USER_ID=treasury

# Pricing and FX.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
EXCHANGERATE_API_KEY=
# Fixed USD->NGN rate for naira display, used until a live FX/price feed is
# wired up. Defaults to 1390 if unset.
USD_NGN_FIXED_RATE=1390

# Fiat on/off ramp providers.
YELLOW_CARD_API_URL=
YELLOW_CARD_API_KEY=
PAYCHANT_API_URL=
PAYCHANT_API_KEY=

# KYC, AML, and PIN verification.
KYC_PROVIDER=smileid
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
PIN_PEPPER=
# Wrong-PIN attempts allowed per pending payment before it is cancelled.
MAX_PIN_ATTEMPTS=3
# KYC tier granted on completing browser onboarding (terms + PIN). Tier 0 has
# {daily: 0, single: 0} limits, so leaving users there blocks every payment.
# Set to 0 to require a real KYC decision before any payment is allowed.
ONBOARDING_KYC_TIER=1
# Country code assumed when a user types a local-format phone number.
DEFAULT_COUNTRY_CODE=234

# The chain's native (gas) currency. Lisk is an OP Stack L2, so gas is paid in
# ETH — LSK itself lives on the chain as an ordinary ERC-20.
LISK_NATIVE_SYMBOL=ETH

# Platform gas wallet that refills user wallets with ETH before a transfer.
# Ask sendam-custody for the reserved "system:lisk-gas-wallet" ref, then fund
# the address it returns from https://console.optimism.io/faucet .
# sendam-paymaster is optional; this alone is enough. See docs/funding-testnet.md
LISK_GAS_WALLET_ADDRESS=
# Refill a user wallet when it drops below this, up to this. A transfer costs
# ~0.0000001 ETH, so these are ~500 and ~2000 transfers respectively.
LISK_GAS_MIN_BALANCE=0.00005
LISK_GAS_TOPUP_TO=0.0002

# In-chat testnet faucet: users say "fund me" and get test USDC.e, because they
# cannot fund their own wallets (signing keys live in sendam-custody).
# Drips from LISK_FAUCET_WALLET_ADDRESS, or the gas wallet above if unset.
# Hard-gated to testnet chain ids in code — never runs on Lisk mainnet.
TESTNET_FAUCET_ENABLED=true
TESTNET_FAUCET_AMOUNT=10
TESTNET_FAUCET_COOLDOWN_HOURS=24
TESTNET_FAUCET_MAX_PER_USER=5
LISK_FAUCET_WALLET_ADDRESS=
TIER_1_DAILY_LIMIT=50000
TIER_1_SINGLE_LIMIT=20000
TIER_2_DAILY_LIMIT=500000
TIER_2_SINGLE_LIMIT=200000
TIER_3_DAILY_LIMIT=5000000
TIER_3_SINGLE_LIMIT=1000000

# Voice payments.
VOICE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
WHISPER_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2 for media/receipt storage.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
